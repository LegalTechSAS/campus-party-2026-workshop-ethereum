# Copiá este archivo como .env y completalo personalmente en tu editor.
# Usá cuentas exclusivas de prueba. No publiques .env ni lo pegues en chats.
# Este endpoint público funciona sin API key; podés usar tu proveedor de RPC HTTPS.
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Tres cuentas distintas: cada una necesita ETH de Sepolia para firmar su parte.
CLIENT_PRIVATE_KEY=
PROVIDER_PRIVATE_KEY=
EVALUATOR_PRIVATE_KEY=

# Límites de gas en ETH de prueba. No cambian el precio de 10 CAMPUS por servicio.
SEPOLIA_MAX_FEE_GWEI=20
SEPOLIA_MAX_TX_COST_ETH=0.05

# Opcional: publica el resumen final (también si es rechazado) en IPFS público.
# El original y las claves nunca se suben. false conserva el funcionamiento local.
PUBLISH_TO_IPFS=false
# JWT de Pinata con permiso de subir archivos; no compartir ni versionar.
PINATA_JWT=

# Alternativa al JWT: requiere ambos valores, con permiso pinFileToIPFS.
# Si completás este par, se usa antes que PINATA_JWT.
PINATA_API_KEY=
PINATA_API_SECRET=
